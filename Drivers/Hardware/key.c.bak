#include "Key.h"

// 按键状态定义
#define KEY_PRESSED				1        // 按键按下状态
#define KEY_UNPRESSED			0        // 按键释放状态

// 时间参数定义（单位：ms）
#define KEY_TIME_DOUBLE       200       // 双击最大间隔时间：在200ms内再次按下视为双击
#define KEY_TIME_LONG         2000      // 长按最小时间：持续按下2000ms视为长按
#define KEY_TIME_REPEAT       100       // 长按后重复触发间隔：长按后每100ms触发一次重复事件
 
uint8_t Key_Flag;

void Key_Init(void)  //第0位：按住不放   1：按下时   2：松开时   3：单击   4：双击   5：长按   6：重复
{
	RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOC, ENABLE);
	
	GPIO_InitTypeDef GPIO_InitStructure;
	GPIO_InitStructure.GPIO_Mode = GPIO_Mode_IPU;
	GPIO_InitStructure.GPIO_Pin = GPIO_Pin_15;
	GPIO_InitStructure.GPIO_Speed = GPIO_Speed_50MHz;
	GPIO_Init(GPIOC, &GPIO_InitStructure);
}

uint8_t Key_GetState()
{
	if(GPIO_ReadInputDataBit(GPIOC,GPIO_Pin_15)==0)
		return KEY_PRESSED;
	else
		return KEY_UNPRESSED;
}

uint8_t Key_Check(uint8_t Flag)
{
	if(Key_Flag&Flag)
	{
		if(Key_Flag!=KEY_HOLD)
		{
			Key_Flag&=~Flag;
		}
		return 1;
	}
	return 0;
	
}

void Key_Clear(void)
{

}

void Key_Tick(void)
{
	static uint8_t Count;
	static uint8_t CurrState,PrevState;
	static uint8_t s;
	static uint16_t time;
	if(time>0)
	{time--;}
	Count++;
	if(Count>=20)
	{
		PrevState=CurrState;
		CurrState=Key_GetState();
	}
	if(CurrState==KEY_PRESSED)
	{
		Key_Flag |=KEY_HOLD;
	
	}
	else
	{
		Key_Flag &=~KEY_HOLD; 
	}
	
	if(CurrState==KEY_PRESSED&&PrevState==KEY_UNPRESSED)
	{
		Key_Flag =KEY_DOWN;
	}
	
	if(CurrState==KEY_UNPRESSED&&PrevState==KEY_PRESSED)
	{
		Key_Flag =KEY_UP;
	}
	if(s==0)
	{
		if(CurrState==KEY_PRESSED)
		{
			time=2000 ;
			s=1;
		}
	}
	else if(s==1)
	{
		if(CurrState==KEY_UNPRESSED)
		{
			s=2;
			time=200;
		}
		else if(time==0)
		{
			Key_Flag |=KEY_LONG;
			s=4;
			time=100;
		}
	}
	else if(s==2)
	{
		if(CurrState==KEY_PRESSED)
		{
			Key_Flag |=KEY_DOUBLE;
			s=3;
		}
		else if(time==0)
		{
			Key_Flag |=KEY_SINGLE;
			s=0;
		}
	
	}
	else if(s==3)
	{
		if(CurrState==KEY_UNPRESSED)
		{
			s=0;
		}
		
	}
	else if(s==4)
	{
		if(CurrState==KEY_UNPRESSED)
		{
			s=0;
		}
		else if(time==0)
		{
			time=100;
			s=4;
			Key_Flag |=KEY_REPEAT;
		}
	}
}

