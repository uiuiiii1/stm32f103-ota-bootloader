#ifndef __KEY_H
#define __KEY_H


// // 按键总数量
// #define KEY_COUNT               4
// // 按键编号定义
// #define KEY_1                   0
// #define KEY_2                   1
// #define KEY_3                   2
// #define KEY_4                   3

// 按键事件标志位掩码
#define KEY_HOLD                0x01    // 按键保持按住
#define KEY_DOWN                0x02    // 按键按下（边沿触发）
#define KEY_UP                  0x04    // 按键释放
#define KEY_SINGLE              0x08    // 单击事件
#define KEY_DOUBLE              0x10    // 双击事件
#define KEY_LONG                0x20    // 长按事件
#define KEY_REPEAT              0x40    // 长按连续重复触发

extern uint8_t Key_Flag;                // 按键事件标志变量

void Key_Init(void);                    // 按键IO初始化
uint8_t Key_Check(uint8_t Flag);        // 查询是否存在指定按键事件
void Key_Clear(void);                   // 清空按键事件标志
void Key_Tick(void);                    // 按键扫描定时函数，放在10ms定时器中调用



#endif /* __KEY_H */
